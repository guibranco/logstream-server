    },
    {
      "name": "test-app-30d",
      "app_key": "test-app",
      "older_than_days": 30
    },
    {
      "name": "hotmail-glob-30d",
      "message_glob": "*@hotmail.com*",
      "older_than_days": 30
    }
  ]
}
