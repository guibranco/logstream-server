# ─── Server ───────────────────────────────────────────────────────────────────
HTTP_PORT=8081
WS_PORT=8080

# Write key — required on POST /api/logs (your applications use this)
API_SECRET=change-me-to-a-strong-secret

# Read key — required on GET /api/logs and WebSocket connections (your UI uses this)
UI_SECRET=change-me-to-another-strong-secret

# Generate both with: php bin/generate-secret.php

# ─── Secret prefixes ──────────────────────────────────────────────────────────
# Prefixes for newly generated secrets, so they are recognisable at a glance and
# by secret scanners. Up to 32 letters, digits, "_" or "-"; empty = no prefix.
# Changing them never alters or invalidates secrets that already exist.
#   API_SECRET_PREFIX  — API_SECRET (file mode write key), via bin/generate-secret.php
#   UI_SECRET_PREFIX   — UI_SECRET (read key), via bin/generate-secret.php
#   APP_TOKEN_PREFIX   — per-application api_token created or rotated through
#                        /api/clients (MariaDB mode)
API_SECRET_PREFIX=lsa_
UI_SECRET_PREFIX=lsu_
APP_TOKEN_PREFIX=lss_

# Application version — injected by CI during deploy; set manually for local dev
APP_VERSION=dev

# Reverse proxies whose X-Forwarded-For / X-Real-IP headers are trusted when
# recording each entry's sender_ip (comma-separated IPs or CIDR ranges).
# Leave empty when clients connect directly.
# e.g. 127.0.0.1,::1 (Nginx on the same host) or 172.16.0.0/12 (Docker network)
TRUSTED_PROXIES=

# ─── Retention ────────────────────────────────────────────────────────────────
# Path to the retention config JSON file (relative to project root or absolute)
# Copy retention.example.json → retention.json and customise.
# Leave unset to disable retention entirely.
RETENTION_CONFIG=./retention.json

# ─── Storage ──────────────────────────────────────────────────────────────────
# Options: "mariadb" | "file"
STORAGE_TYPE=file

# Used when STORAGE_TYPE=file
LOG_PATH=./storage/logs

# Used when STORAGE_TYPE=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=logservice
DB_USER=logservice
DB_PASS=secret
