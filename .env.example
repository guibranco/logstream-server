# ─── Server ───────────────────────────────────────────────────────────────────
HTTP_PORT=8081
WS_PORT=8080

# Write key — required on POST /api/logs (your applications use this)
API_SECRET=change-me-to-a-strong-secret

# Read key — required on GET /api/logs and WebSocket connections (your UI uses this)
UI_SECRET=change-me-to-another-strong-secret

# Generate both with: php bin/generate-secret.php

# ─── Secret prefixes ──────────────────────────────────────────────────────────
# Prefixes for newly generated secrets, so they are recognisable at a glance and
# by secret scanners. Up to 32 letters, digits, "_" or "-"; empty = no prefix.
# Changing them never alters or invalidates secrets that already exist.
#   API_SECRET_PREFIX  — API_SECRET (file mode write key), via bin/generate-secret.php
#   UI_SECRET_PREFIX   — UI_SECRET (read key), via bin/generate-secret.php
#   APP_TOKEN_PREFIX   — per-application api_token created or rotated through
#                        /api/clients (MariaDB mode)
API_SECRET_PREFIX=lsa_
UI_SECRET_PREFIX=lsu_
APP_TOKEN_PREFIX=lss_

# Application version — injected by CI during deploy; set manually for local dev
APP_VERSION=dev

# Reverse proxies whose X-Forwarded-For / X-Real-IP headers are trusted when
# recording each entry's sender_ip (comma-separated IPs or CIDR ranges).
# Leave empty when clients connect directly.
# e.g. 127.0.0.1,::1 (Nginx on the same host) or 172.16.0.0/12 (Docker network)
TRUSTED_PROXIES=

# ─── Retention ────────────────────────────────────────────────────────────────
# Path to the retention config JSON file (relative to project root or absolute)
# Copy retention.example.json → retention.json and customise.
# Leave unset to disable retention entirely.
RETENTION_CONFIG=./retention.json

# ─── Ingest ───────────────────────────────────────────────────────────────────
# How POST /api/logs stores entries:
#   buffered — validate, queue in memory, answer 202 Accepted; a timer writes
#              the queue in batches. Clients that must know an entry is stored
#              send "Prefer: return=representation" and get 201 once it is.
#   sync     — write every entry before answering 201 (the original behaviour).
INGEST_MODE=buffered

# Client used to write buffered entries to MariaDB (ignored for file storage
# and in sync mode). Reads, clients and retention always use PDO.
#   async — non-blocking ReactPHP connection: flushing never stalls the server
#   pdo   — the blocking PDO connection, one multi-row INSERT per flush
DB_DRIVER=async

# Maximum entries per INSERT / file write, and how often the queue is flushed
# when it holds fewer than that.
INGEST_BATCH_SIZE=500
INGEST_FLUSH_INTERVAL_MS=500

# Queued + in-flight entries above which POST /api/logs answers 503 with
# Retry-After (bounds memory while storage is down). ~1 KB per entry.
INGEST_BUFFER_CAPACITY=50000

# How long a "Prefer: return=representation" request waits for its write
# before answering 202 instead.
INGEST_WAIT_TIMEOUT_MS=10000

# On SIGTERM/SIGINT the server stops accepting connections and writes what is
# still queued, for at most this long, before exiting. Keep it below the
# supervisor's stop timeout (systemd TimeoutStopSec, Docker stop grace: 10s).
INGEST_SHUTDOWN_TIMEOUT_MS=8000

# ─── Self-logging ─────────────────────────────────────────────────────────────
# The server stores its own messages — startup, PHP deprecations, notices,
# warnings and errors, uncaught exceptions, failed ingest flushes, retention
# runs, shutdown — as log entries of the application "logstream-server".
# That app_key is reserved: it is not in the clients table, cannot be
# registered and is rejected on POST /api/logs. Console output is unchanged.
#   SELF_LOG_ENABLED — false to stop storing them (they are still printed)
#   SELF_LOG_LEVEL   — lowest level stored: debug|info|notice|warning|error|critical
#                      (PHP deprecations and notices are "notice")
#   SELF_LOG_APP_ID  — app_id of the entries; defaults to the host name
SELF_LOG_ENABLED=true
SELF_LOG_LEVEL=info
SELF_LOG_APP_ID=

# ─── Storage ──────────────────────────────────────────────────────────────────
# Options: "mariadb" | "file"
STORAGE_TYPE=file

# Used when STORAGE_TYPE=file
LOG_PATH=./storage/logs

# Used when STORAGE_TYPE=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=logservice
DB_USER=logservice
DB_PASS=secret
